# ==== LLM (OpenAI-compatible: OpenAI, DeepSeek, vLLM, Ollama...) ====
NETDOCTOR_LLM_API_KEY=sk-your-key
NETDOCTOR_LLM_MODEL=gpt-4o-mini
# Đặt trỏ tới proxy/local gateway nếu cần, ví dụ Ollama: http://localhost:11434/v1
NETDOCTOR_LLM_BASE_URL=https://api.openai.com/v1

# ==== Đường dẫn ====
NETDOCTOR_HOSTS_FILE=configs/hosts.yaml
NETDOCTOR_REPORTS_DIR=logs/reports

# ==== Hành vi ====
# Delay (giây) giữa 2 lệnh SSH để không làm nghẽn host mục tiêu
NETDOCTOR_COMMAND_DELAY=0.3
NETDOCTOR_CONNECT_TIMEOUT=10
NETDOCTOR_COMMAND_TIMEOUT=60
